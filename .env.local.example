# ──────────────────────────────────────────────────────────────────────
#  Khaki AI — environment template
#  Copy to `.env.local` and fill in. Everything here is optional except
#  the studio number; without an AI key the assistant still answers from
#  its built-in studio knowledge.
# ──────────────────────────────────────────────────────────────────────

# Studio WhatsApp number, international format, digits only.
# NOTE: when this is set it overrides KHAKI_CONFIG.contact.whatsappNumber in
# src/config/khaki.ts. Leave it empty to let the config file win.
NEXT_PUBLIC_WHATSAPP_NUMBER=255746885113

# The real address of the site, once it is deployed.
# Without it, metadataBase falls back to localhost and every shared link —
# the WhatsApp preview in particular — points at a machine nobody can reach.
NEXT_PUBLIC_SITE_URL=

# Google Gemini — https://aistudio.google.com/apikey
# This is the primary brain. Also editable later in /admin.
GEMINI_API_KEY=

# The same key under the name the AI SDK's own docs use. Read as a fallback, so
# either name works — but it is read, and until now it was not written down
# here, which meant a deploy that set only this one would look misconfigured to
# anyone reading this file.
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI (optional, only if you want to compare answers)
OPENAI_API_KEY=

# ──────────────────────────────────────────────────────────────────────
#  /admin access
# ──────────────────────────────────────────────────────────────────────
# Leave unset on your own machine: requests from localhost are trusted.
# SET THIS BEFORE DEPLOYING — without it, /admin refuses everyone on a
# public host (it does not fall open).
ADMIN_TOKEN=

# Where the admin panel stores its overrides. Defaults to ./data/runtime-settings.json
# KHAKI_SETTINGS_PATH=

# Set to "false" to omit the Secure flag on the admin cookie (plain-HTTP LAN testing)
# KHAKI_SECURE_COOKIES=true
