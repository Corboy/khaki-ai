node-linker=hoisted
strict-peer-dependencies=false
auto-install-peers=true

# Off because pnpm otherwise runs `pnpm install` by itself before every script,
# and on a machine where `pnpm` is not on PATH that self-install fails and takes
# the whole check with it — which reads as the project being broken rather than
# the runner being configured differently.
#
# Build-script approval is not here. `.npmrc` cannot grant it; it belongs in
# `allowBuilds` in pnpm-workspace.yaml, and the comment there explains why that
# file also carries a `packages` list that matches nothing.
verify-deps-before-run=false
