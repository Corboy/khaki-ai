{
  "name": "khaki-ai",
  "version": "2.0.0",
  "private": true,
  "description": "Khaki AI — Apple-grade studio assistant for Khaki Media (Next.js + assistant-ui + Vercel AI SDK + Google Gemini)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --import ./tools/register-alias.mjs --test tests/business-logic.test.ts",
    "audit:classes": "node tools/audit-classes.mjs",
    "audit:studio": "node tools/check-studio-data.mjs",
    "check": "tsc --noEmit && next lint && node --no-warnings --import ./tools/register-alias.mjs --test tests/business-logic.test.ts && node tools/check-studio-data.mjs && node tools/audit-classes.mjs",
    "bench:models": "node tools/bench-models.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/react": "^4.0.130",
    "@assistant-ui/react": "^0.15.23",
    "@assistant-ui/react-ai-sdk": "^1.4.14",
    "@assistant-ui/react-markdown": "^0.14.18",
    "ai": "^7.0.127",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
